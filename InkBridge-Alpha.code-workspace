{
  "folders": [
    {
      "name": "InkBridge / 墨桥",
      "path": "inkbridge.koplugin"
    },
    {
      "name": "KOReader 上游源码(API 核对)",
      "path": "koreader-master"
    },
    {
      "name": "参考:koreader-base / syncery",
      "path": "reference"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/*.zip": true,
      "**/thirdparty/**": true,
      "**/spec/**": true,
      "**/ffi-cdecl/**": true
    },
    "search.exclude": {
      "**/*.zip": true,
      "**/koreader-master/**": true,
      "**/reference/**": true,
      "**/releases/**": true,
      "**/thirdparty/**": true
    },
    "files.associations": {
      "*.lua": "lua"
    },
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
  }
}
